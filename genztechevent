    <script>
        const TOTAL_SEATS = 150;
        const ROWS = 10;
        const SEATS_PER_ROW = 15;
        
        let selectedSeatId = null;
        let seatsRemaining = 0;

        // All 150 seats marked as taken/reserved
        const takenSeatIds = new Set();
        for (let r = 0; r < ROWS; r++) {
            const rowLetter = String.fromCharCode(65 + r);
            for (let s = 1; s <= SEATS_PER_ROW; s++) {
                takenSeatIds.add(`${rowLetter}${s}`);
            }
        }

        function renderSeatGrid() {
            const gridContainer = document.getElementById('seatGrid');
            gridContainer.innerHTML = '';

            for (let r = 0; r < ROWS; r++) {
                const rowLetter = String.fromCharCode(65 + r);
                const rowDiv = document.createElement('div');
                rowDiv.className = 'flex items-center space-x-1.5 sm:space-x-2';

                const label = document.createElement('span');
                label.className = 'w-6 text-xs text-slate-500 font-bold font-mono text-center';
                label.textContent = rowLetter;
                rowDiv.appendChild(label);

                for (let s = 1; s <= SEATS_PER_ROW; s++) {
                    const seatId = `${rowLetter}${s}`;

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.setAttribute('data-seat-id', seatId);
                    btn.disabled = true;

                    let baseClasses = 'w-6 h-6 sm:w-7 sm:h-7 rounded text-[10px] font-mono flex items-center justify-center transition-all duration-200 ';
                    btn.className = baseClasses + 'bg-rose-950/40 border border-rose-900/60 text-rose-500/70 cursor-not-allowed';

                    btn.textContent = s;

                    rowDiv.appendChild(btn);
                }

                gridContainer.appendChild(rowDiv);
            }
            updateSeatsDisplay();
        }

        function selectSeat(seatId) {
            // Disabled since sold out
        }

        function updateSeatsDisplay() {
            document.getElementById('seatsRemainingCount').textContent = seatsRemaining;
            document.getElementById('seatsProgressBar').style.width = '100%';
        }

        lucide.createIcons();
        renderSeatGrid();

        function scrollToSignup() {
            document.getElementById('signup-section').scrollIntoView({ behavior: 'smooth' });
        }

        function handleRegistration(e) {
            e.preventDefault();

            if (!selectedSeatId) {
                alert('Please select a seat from the interactive layout before submitting.');
                document.getElementById('seatGrid').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            const name = document.getElementById('fullName').value;
            const school = document.getElementById('schoolInput').value;
            const appleId = document.getElementById('appleId').value;

            document.getElementById('modalName').textContent = name;
            document.getElementById('modalSchool').textContent = school;
            document.getElementById('modalAppleId').textContent = appleId;
            document.getElementById('modalSeat').textContent = selectedSeatId;

            takenSeatIds.add(selectedSeatId);
            seatsRemaining = Math.max(0, seatsRemaining - 1);

            const modal = document.getElementById('confirmationModal');
            modal.classList.remove('hidden');
        }

        function closeModal() {
            const modal = document.getElementById('confirmationModal');
            modal.classList.add('hidden');
            selectedSeatId = null;
            document.getElementById('formSeatLabel').textContent = "No Seat Selected Yet";
            document.getElementById('selectedSeatNotice').classList.add('hidden');
            document.getElementById('signupForm').reset();
            renderSeatGrid();
        }
    </script>
</body>
</html>
